# Copia este archivo como .env (en esta misma carpeta) y completa los valores. Nunca subas .env a GitHub.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/turbouniversal
# true si la base exige SSL (Supabase o la URL externa de Render)
DATABASE_SSL=false
JWT_SECRETO=cambia-esto-por-un-texto-largo-y-aleatorio
PANEL_CLAVE=cambia-esta-clave
# Dominios del front separados por coma
ORIGEN_FRONT=http://localhost:3000
PORT=4000
